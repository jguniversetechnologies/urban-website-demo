# Homify Website Environment Variables
# Demo Configuration - No real API keys needed for demo

# Google Maps (Demo - will use mock location data)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=demo_key_for_testing

# SMS/OTP Service (Demo - will use mock OTP)
SMS_PROVIDER=demo
SMS_API_KEY=demo_key
SMS_SENDER_ID=HOMIFY

# Payment Gateway (Demo - will use mock payment)
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=demo_key_id
RAZORPAY_KEY_SECRET=demo_key_secret

# Firebase (Demo - will use mock notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=demo_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=demo_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=demo_app_id

# Cloud Storage (Demo - will use mock uploads)
STORAGE_PROVIDER=demo
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret
CLOUDINARY_UPLOAD_PRESET=homify_uploads

# Email Service (Demo - will use mock emails)
EMAIL_PROVIDER=demo
EMAIL_API_KEY=demo_api_key
FROM_EMAIL=noreply@homify.com
FROM_NAME=Homify

# Analytics (Demo - will use mock analytics)
ANALYTICS_PROVIDER=demo
NEXT_PUBLIC_GA_MEASUREMENT_ID=demo_measurement_id

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3003
NODE_ENV=development